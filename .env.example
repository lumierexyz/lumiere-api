# Copy to .env for local development. Never commit real values.
ENVIRONMENT=development

# Supabase Postgres (Settings > Database > Connection string, "Session pooler", SQLAlchemy form).
# Use sslmode=require so traffic is encrypted in transit.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Accounts: Privy email-code sign-up (default). The app id is public; the secret is server-only and
# is used to read the verified email of new users and to delete their Privy account on request.
AUTH_PROVIDER=privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Alternative: AUTH_PROVIDER=supabase. The project URL is enough for JWKS verification.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Only for legacy projects that still sign access tokens with the shared HS256 secret:
SUPABASE_JWT_SECRET=
# Optional, server-side only: lets DELETE /api/v1/me also remove the Supabase auth user.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://lumiere-coral-kappa.vercel.app

# Economic data
FRED_API_KEY=
EUROSTAT_HICP_DATASET=prc_hicp_minr
ECONOMIC_DATA_TTL_HOURS=24

# Anthropic (transaction classification fallback and the agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Limits
MAX_UPLOAD_BYTES=5242880
MAX_CSV_ROWS=50000
RATE_LIMIT_PER_MINUTE=120
AGENT_RATE_LIMIT_PER_MINUTE=12
